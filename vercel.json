{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin/:match*"
    },
    {
      "source": "/((?!admin|uploads|assets).*)",
      "destination": "/index.html"
    }
  ]
}
