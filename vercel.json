{
  "rewrites": [
    {
      "source": "/admin/index.html",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/assets/:match*",
      "destination": "/admin/assets/:match*"
    },
    {
      "source": "/((?!uploads|assets).*)",
      "destination": "/index.html"
    }
  ]
}
